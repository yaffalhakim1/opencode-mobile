<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Android 13+ requires this to be granted at runtime. The app asks after the
      first successful connection rather than on launch, and works silently if
      it is refused: push is an addition, not a dependency.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only used to scan a pairing QR; the app works without it via URL + password. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".OpenCodeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenCodeMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OpenCodeMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              A notification tap opens opencode://session/<id>. The activity is
              singleTop so a tap while the app is already open delivers
              onNewIntent instead of starting a second copy of the app on top of
              the first, which would leave two chat screens in the back stack.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opencode" android:host="session" />
            </intent-filter>
        </activity>

        <!--
          FCM starts this service itself when a message arrives; nothing in the
          app calls it, so it is not exported. It must stay declared here or
          data messages are silently dropped.
        -->
        <service
            android:name=".core.push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
